<?xml version="1.0" encoding="UTF-8"?>
<!-- GTK 3 / GtkBuilder. Edit this file in Glade, or change it directly. -->
<interface>
  <requires lib="gtk+" version="3.22"/>
  <object class="GtkWindow" id="main_window">
    <property name="title">MNX Archive Manager</property>
    <property name="default-width">1120</property>
    <property name="default-height">720</property>
    <property name="width-request">760</property>
    <property name="height-request">480</property>
    <property name="window-position">center</property>
    <child>
      <object class="GtkBox" id="main_layout">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkMenuBar" id="menu_bar">
            <property name="visible">True</property>
            <child>
              <object class="GtkMenuItem" id="file_menu">
                <property name="visible">True</property><property name="label">_File</property><property name="use-underline">True</property>
                <child type="submenu"><object class="GtkMenu" id="file_submenu">
                  <child><object class="GtkMenuItem" id="menu_new"><property name="visible">True</property><property name="label">New archive…</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_open"><property name="visible">True</property><property name="label">Open archive…</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_resume"><property name="visible">True</property><property name="label">Resume from queue…</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_close"><property name="visible">True</property><property name="label">Close archive</property></object></child>
                  <child><object class="GtkSeparatorMenuItem"><property name="visible">True</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_quit"><property name="visible">True</property><property name="label">Quit</property></object></child>
                </object></child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="actions_menu">
                <property name="visible">True</property><property name="label">_Actions</property><property name="use-underline">True</property>
                <child type="submenu"><object class="GtkMenu" id="actions_submenu">
                  <child><object class="GtkMenuItem" id="menu_add"><property name="visible">True</property><property name="label">Add files…</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_extract"><property name="visible">True</property><property name="label">Extract…</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_test"><property name="visible">True</property><property name="label">Test archive</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_delete"><property name="visible">True</property><property name="label">Delete selected entries</property></object></child>
                  <child><object class="GtkSeparatorMenuItem"><property name="visible">True</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_compact"><property name="visible">True</property><property name="label">Compact archive</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_info"><property name="visible">True</property><property name="label">Archive information</property></object></child>
                </object></child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="help_menu">
                <property name="visible">True</property><property name="label">_Help</property><property name="use-underline">True</property>
                <child type="submenu"><object class="GtkMenu" id="help_submenu">
                  <child><object class="GtkMenuItem" id="menu_options"><property name="visible">True</property><property name="label">Options…</property></object></child>
                  <child><object class="GtkMenuItem" id="menu_about"><property name="visible">True</property><property name="label">About MNX</property></object></child>
                </object></child>
              </object>
            </child>
          </object>
          <packing><property name="expand">False</property><property name="fill">True</property></packing>
        </child>
        <child>
          <object class="GtkToolbar" id="archive_toolbar">
            <property name="visible">True</property><property name="name">archive_toolbar</property>
            <property name="toolbar-style">both</property><property name="icon-size">6</property>
            <child><object class="GtkToolButton" id="action_new"><property name="visible">True</property><property name="label">New</property><property name="tooltip-text">Create a new archive</property></object></child>
            <child><object class="GtkToolButton" id="action_open"><property name="visible">True</property><property name="label">Open</property><property name="tooltip-text">Open an archive (Ctrl+O)</property></object></child>
            <child><object class="GtkSeparatorToolItem"><property name="visible">True</property></object></child>
            <child><object class="GtkToolButton" id="action_add"><property name="visible">True</property><property name="label">Add</property><property name="tooltip-text">Add files or folders to the current folder</property></object></child>
            <child><object class="GtkToolButton" id="action_extract"><property name="visible">True</property><property name="label">Extract</property><property name="tooltip-text">Extract selected entries, or the entire archive</property></object></child>
            <child><object class="GtkToolButton" id="action_test"><property name="visible">True</property><property name="label">Test</property><property name="tooltip-text">Verify archive contents</property></object></child>
            <child><object class="GtkToolButton" id="action_delete"><property name="visible">True</property><property name="label">Delete</property><property name="tooltip-text">Delete selected archive entries</property></object></child>
            <child><object class="GtkSeparatorToolItem"><property name="visible">True</property></object></child>
            <child><object class="GtkToolButton" id="action_compact"><property name="visible">True</property><property name="label">Compact</property><property name="tooltip-text">Fill archive holes and truncate unused space</property></object></child>
            <child><object class="GtkToolButton" id="action_info"><property name="visible">True</property><property name="label">Info</property><property name="tooltip-text">Archive information</property></object></child>
          </object>
          <packing><property name="expand">False</property><property name="fill">True</property></packing>
        </child>
        <child>
          <object class="GtkBox" id="path_bar">
            <property name="visible">True</property><property name="name">path_bar</property><property name="spacing">6</property>
            <child><object class="GtkButton" id="navigate_up"><property name="visible">True</property><property name="tooltip-text">Go to parent folder (Alt+Up)</property><child><object class="GtkImage"><property name="visible">True</property></object></child></object><packing><property name="expand">False</property></packing></child>
            <child><object class="GtkButton" id="navigate_root"><property name="visible">True</property><property name="tooltip-text">Go to archive root</property><child><object class="GtkImage"><property name="visible">True</property></object></child></object><packing><property name="expand">False</property></packing></child>
            <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Path:</property></object><packing><property name="expand">False</property></packing></child>
            <child><object class="GtkEntry" id="current_path"><property name="visible">True</property><property name="text">/</property><property name="tooltip-text">Path inside the archive — press Enter to navigate</property><property name="hexpand">True</property></object><packing><property name="expand">True</property><property name="fill">True</property></packing></child>
          </object>
          <packing><property name="expand">False</property><property name="fill">True</property></packing>
        </child>
        <child>
          <object class="GtkPaned" id="browser_split">
            <property name="visible">True</property><property name="orientation">horizontal</property>
            <property name="wide-handle">True</property><property name="position">336</property>
            <child>
              <object class="GtkBox" id="folder_pane">
                <property name="visible">True</property><property name="orientation">vertical</property><property name="width-request">160</property>
                <child><object class="GtkLabel"><property name="visible">True</property><property name="label">Folders</property><property name="xalign">0</property><property name="margin-start">10</property><property name="margin-top">5</property><property name="margin-bottom">5</property></object><packing><property name="expand">False</property></packing></child>
                <child>
                  <object class="GtkScrolledWindow" id="folder_scroll">
                    <property name="visible">True</property><property name="shadow-type">in</property>
                    <child><object class="GtkTreeView" id="folder_tree"><property name="visible">True</property><property name="headers-visible">False</property><property name="enable-search">True</property><property name="search-column">1</property>
                      <child><object class="GtkTreeViewColumn" id="folder_name_column">
                        <child><object class="GtkCellRendererPixbuf" id="folder_icon_renderer"/><attributes><attribute name="pixbuf">0</attribute></attributes></child>
                        <child><object class="GtkCellRendererText" id="folder_name_renderer"/><attributes><attribute name="text">1</attribute></attributes></child>
                      </object></child>
                    </object></child>
                  </object>
                  <packing><property name="expand">True</property><property name="fill">True</property></packing>
                </child>
              </object>
              <packing><property name="resize">True</property><property name="shrink">False</property></packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="files_scroll">
                <property name="visible">True</property><property name="shadow-type">in</property><property name="width-request">360</property>
                <child><object class="GtkTreeView" id="file_list"><property name="visible">True</property><property name="headers-visible">True</property><property name="enable-search">True</property><property name="search-column">1</property><property name="rubber-banding">True</property>
                    <child><object class="GtkTreeViewColumn" id="file_name_column">
                      <property name="title">Name</property><property name="resizable">True</property><property name="expand">True</property><property name="min-width">180</property><property name="sizing">fixed</property><property name="fixed-width">260</property><property name="sort-column-id">1</property>
                      <child><object class="GtkCellRendererPixbuf" id="file_icon_renderer"/><attributes><attribute name="pixbuf">0</attribute></attributes></child>
                      <child><object class="GtkCellRendererText" id="file_name_renderer"><property name="ellipsize">end</property></object><attributes><attribute name="text">1</attribute></attributes></child>
                    </object></child>
                    <child><object class="GtkTreeViewColumn" id="file_type_column">
                      <property name="title">Type</property><property name="resizable">True</property><property name="min-width">75</property><property name="sort-column-id">10</property>
                      <child><object class="GtkCellRendererText" id="file_type_renderer"/><attributes><attribute name="text">10</attribute></attributes></child>
                    </object></child>
                    <child><object class="GtkTreeViewColumn" id="file_size_column">
                      <property name="title">Size</property><property name="resizable">True</property><property name="min-width">90</property><property name="alignment">1</property><property name="sort-column-id">8</property>
                      <child><object class="GtkCellRendererText" id="file_size_renderer"><property name="xalign">1</property></object><attributes><attribute name="text">2</attribute></attributes></child>
                    </object></child>
                    <child><object class="GtkTreeViewColumn" id="file_flags_column">
                      <property name="title">[CES]</property><property name="resizable">True</property><property name="min-width">65</property><property name="alignment">0.5</property><property name="sort-column-id">3</property>
                      <child><object class="GtkCellRendererText" id="file_flags_renderer"><property name="xalign">0.5</property></object><attributes><attribute name="text">3</attribute></attributes></child>
                    </object></child>
                    <child><object class="GtkTreeViewColumn" id="file_bytes_column">
                      <property name="title">Bytes</property><property name="resizable">True</property><property name="min-width">130</property><property name="alignment">1</property><property name="sort-column-id">8</property>
                      <child><object class="GtkCellRendererText" id="file_bytes_renderer"><property name="xalign">1</property></object><attributes><attribute name="text">4</attribute></attributes></child>
                    </object></child>
                    <child><object class="GtkTreeViewColumn" id="file_chunks_column">
                      <property name="title">Chunks</property><property name="resizable">True</property><property name="min-width">80</property><property name="alignment">1</property><property name="sort-column-id">12</property>
                      <child><object class="GtkCellRendererText" id="file_chunks_renderer"><property name="xalign">1</property></object><attributes><attribute name="text">11</attribute></attributes></child>
                    </object></child>
                    <child><object class="GtkTreeViewColumn" id="file_date_column">
                      <property name="title">Created</property><property name="resizable">True</property><property name="min-width">100</property><property name="sort-column-id">9</property>
                      <child><object class="GtkCellRendererText" id="file_date_renderer"/><attributes><attribute name="text">5</attribute></attributes></child>
                    </object></child>
                  </object></child>
              </object>
              <packing><property name="resize">True</property><property name="shrink">False</property></packing>
            </child>
          </object>
          <packing><property name="expand">True</property><property name="fill">True</property></packing>
        </child>
        <child>
          <object class="GtkBox" id="footer">
            <property name="visible">True</property><property name="name">footer</property><property name="spacing">12</property>
            <child><object class="GtkLabel" id="status_message"><property name="visible">True</property><property name="label">Open an archive to begin.</property><property name="xalign">0</property><property name="ellipsize">end</property><property name="hexpand">True</property></object><packing><property name="expand">True</property><property name="fill">True</property></packing></child>
            <child><object class="GtkProgressBar" id="operation_progress"><property name="visible">False</property><property name="no-show-all">True</property><property name="show-text">True</property><property name="width-request">200</property></object><packing><property name="expand">False</property></packing></child>
            <child><object class="GtkLabel" id="selection_summary"><property name="visible">True</property><property name="label">0 selected</property></object><packing><property name="expand">False</property></packing></child>
          </object>
          <packing><property name="expand">False</property><property name="fill">True</property></packing>
        </child>
      </object>
    </child>
  </object>
</interface>
