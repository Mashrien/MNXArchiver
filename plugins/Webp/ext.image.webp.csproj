<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <MNXBuildNumberReserved>true</MNXBuildNumberReserved>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Plugins/ImageProviderProtocol.cs" Link="ImageProviderProtocol.cs" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
  <!-- Match the patched AOT toolchain used by the archive extension. -->
  <Target Name="UsePatchedNativeAotPack" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <KnownILCompilerPack Condition="'%(KnownILCompilerPack.TargetFramework)' == 'net10.0'
          and $([MSBuild]::VersionLessThan('%(KnownILCompilerPack.ILCompilerPackVersion)', '10.0.14'))">
        <ILCompilerPackVersion>10.0.14</ILCompilerPackVersion>
      </KnownILCompilerPack>
    </ItemGroup>
  </Target>
</Project>
