+        [DllImport("libHarfBuzzSharp", EntryPoint = "hb_font_set_var_named_instance", CallingConvention = CallingConvention.Cdecl)]
+        private static extern void SetVariationNamedInstance(IntPtr font, uint instanceIndex);
+
         /// <summary>
         /// Constructs a new TextShaper 
         /// </summary>
@@ -65,13 +70,21 @@ namespace Topten.RichTextKit
             // Load the typeface stream to a HarfBuzz font
             int index;
             using (var blob = GetHarfBuzzBlob(typeface.OpenStream(out index)))
-            using (var face = new Face(blob, (uint)index))
+            using (var face = new Face(blob, ((uint)index & 0xFFFFu)))
             {
                 face.UnitsPerEm = typeface.UnitsPerEm;
 
