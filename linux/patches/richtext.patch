+++ b/Topten.RichTextKit.Probe.csproj
@@ -0,0 +1,24 @@
+<Project Sdk="Microsoft.NET.Sdk">
+  <!-- Build the pinned 0.4.167 sources without the upstream release/signing submodule.
+       Keep its original compile-time Skia API; the host selects its existing Skia 3 runtime. -->
+  <PropertyGroup>
+    <TargetFramework>netstandard2.0</TargetFramework>
+    <LangVersion>latest</LangVersion>
+    <AssemblyName>Topten.RichTextKit</AssemblyName>
+    <RootNamespace>Topten.RichTextKit</RootNamespace>
+    <Version>0.4.167-mnx-fontfix.1</Version>
+    <AssemblyVersion>0.4.167.0</AssemblyVersion>
+    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
+    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
+  </PropertyGroup>
+  <ItemGroup>
+    <Compile Include="Topten.RichTextKit/**/*.cs" Exclude="Topten.RichTextKit/**/obj/**;Topten.RichTextKit/**/bin/**" />
+    <EmbeddedResource Include="Topten.RichTextKit/Resources/*.trie" LogicalName="Topten.RichTextKit.Resources.%(Filename)%(Extension)" />
+    <!-- The NuGet package supplied Linux native assets separately. Keep managed/native
+         HarfBuzz aligned when building its sources directly. -->
+    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
+    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
+    <PackageReference Include="SkiaSharp" Version="2.88.7" />
+    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.7" />
+  </ItemGroup>
+</Project>
