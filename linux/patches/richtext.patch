                 _font.SetScale(overScale, overScale);
                 _font.SetFunctionsOpenType();
+
+                // MNX Linux probe: FreeType packs a one-based named variation instance
+                // into the upper 16 bits. HarfBuzz needs that separately, zero-based;
+                // passing the packed value as a face index opens an empty font.
+                int namedInstance = (index >> 16) & 0x7FFF;
+                if (namedInstance > 0) {
+                    SetVariationNamedInstance(_font.Handle, (uint)(namedInstance - 1));
+                    }
