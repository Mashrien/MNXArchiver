+using System.Drawing;
+using SkiaSharp;
+
+namespace Majorsilence.Forms {
+    public abstract partial class WindowBase {
+        /// <summary>Renders a top-level form into a caller-owned bitmap without a screen capture.</summary>
+        public void DrawToBitmap(Drawing.Bitmap destination, Rectangle targetBounds) {
+            Guard.ThrowIfNull(destination);
+            if (targetBounds.Width <= 0 || targetBounds.Height <= 0) {
+                return;
+                }
+            using SKSurface surface = SKSurface.Create(new SKImageInfo(Math.Max(1, Size.Width), Math.Max(1, Size.Height)));
+            RenderFrame(surface.Canvas, Math.Max(1, Size.Width), Math.Max(1, Size.Height), 1);
+            using SKImage snapshot = surface.Snapshot();
+            using SKData encoded = snapshot.Encode(SKEncodedImageFormat.Png, 100);
+            using MemoryStream stream = new MemoryStream(encoded.ToArray(), false);
+            using Drawing.Bitmap image = new Drawing.Bitmap(stream);
+            using Graphics graphics = Graphics.FromImage(destination);
+            graphics.DrawImage(image, targetBounds);
+            }
+        }
+    }

