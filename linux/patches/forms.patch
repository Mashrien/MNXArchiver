+                }
+            for (int index = 0; index < filters.Count; index++) {
+                global::Gtk.FileFilter filter = global::Gtk.FileFilter.New();
+                filter.SetName(filters[index].Name);
+                foreach (string pattern in filters[index].Patterns) {
+                    filter.AddPattern(pattern == "*.*" ? "*" : pattern);
+                    }
+                chooser.AddFilter(filter);
+                if (index + 1 == filterIndex) {
+                    chooser.SetFilter(filter);
+                    }
+                }
+            chooser.OnResponse += (_, response) => {
+                try {
+                    List<string> paths = new List<string>();
+                    if (response.ResponseId == (int)global::Gtk.ResponseType.Accept) {
+                        using Gio.ListModel files = chooser.GetFiles();
+                        for (uint index = 0; index < files.GetNItems(); index++) {
+                            using Gio.FileHelper file = Gio.FileHelper.NewFromPointer(files.GetItem(index), true);
+                            string? path = file.GetPath();
+                            if (!string.IsNullOrEmpty(path)) {
