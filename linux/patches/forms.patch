+using System;
+using System.Drawing;
+using SkiaSharp;
+
+namespace Majorsilence.Forms {
+    // Presentation uses the existing raster buffer: no extra full-frame image or pixel copies.
+    internal static class FrameTransparency {
+        internal static void Apply(WindowBase owner, SKSurface surface) {
+            if (!(owner is Form form) || form.TransparencyKey.IsEmpty) {
+                return;
+                }
+            using SKPixmap pixels = surface.PeekPixels();
+            if (pixels == null || (pixels.ColorType != SKColorType.Bgra8888 && pixels.ColorType != SKColorType.Rgba8888)) {
+                throw new NotSupportedException("Color-key transparency requires a 32-bit raster surface.");
+                }
+            Color key = form.TransparencyKey;
+            byte first = pixels.ColorType == SKColorType.Bgra8888 ? key.B : key.R;
+            byte third = pixels.ColorType == SKColorType.Bgra8888 ? key.R : key.B;
+            Span<byte> buffer = pixels.GetPixelSpan();
+            int width = pixels.Width;
+            int height = pixels.Height;
+            int rowBytes = pixels.RowBytes;
+            for (int row = 0; row < height; row++) {
+                int rowStart = row * rowBytes;
+                for (int column = 0; column < width; column++) {
+                    int offset = rowStart + column * 4;
+                    int alpha = buffer[offset + 3];
+                    // Skia stores premultiplied channels. Compare the represented RGB color,
+                    // leaving existing transparent pixels alone and clearing all four keyed bytes.
+                    if (alpha > 0 && Matches(buffer[offset], first, alpha) &&
+                        Matches(buffer[offset + 1], key.G, alpha) && Matches(buffer[offset + 2], third, alpha)) {
+                        buffer.Slice(offset, 4).Clear();
+                        }
+                    }
+                }
+            }
+
+        private static bool Matches(byte channel, byte key, int alpha) {
+            if (alpha == 255) {
+                return channel == key;
+                }
+            return (channel * 255 + alpha / 2) / alpha == key;
+            }
+        }
+    }
