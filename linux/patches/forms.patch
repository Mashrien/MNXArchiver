+        private Task<string[]> ChooseFiles(string title, global::Gtk.FileChooserAction action,
+                string? directory, string? suggestedName, bool multiple, IReadOnlyList<FileDialogFilter> filters, int filterIndex) {
+            TaskCompletionSource<string[]> completion = new TaskCompletionSource<string[]>();
