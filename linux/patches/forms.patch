+using System;
+using System.Collections.Generic;
+using System.Drawing;
+using System.Runtime.InteropServices;
+using SkiaSharp;
+
+namespace Majorsilence.Forms.Gtk4 {
+    internal sealed partial class Gtk4WindowHost {
+        private global::Gtk.CssProvider? _transparencyCss;
+        private bool _isShaped;
+        private bool _inputRegionValid;
+        private List<Rectangle> _inputRows = new List<Rectangle>();
+        private List<Rectangle> _nextInputRows = new List<Rectangle>();
+
+        private void InitializeTransparency() {
+            _surface.UpdateInputRegion = UpdateTransparencyInput;
+            _window.OnRealize += (_, _) => {
+                _inputRegionValid = false;
+                };
+            }
+
+        // A color key needs both transparent frame pixels and a transparent GTK backdrop.
+        public void SetShaped(bool shaped) {
+            if (_isShaped == shaped) {
+                return;
+                }
+            _isShaped = shaped;
+            _inputRegionValid = false;
+            if (shaped) {
+                if (_transparencyCss == null) {
+                    _transparencyCss = global::Gtk.CssProvider.New();
+                    _transparencyCss.LoadFromString("window { background-color: transparent; background-image: none; box-shadow: none; }");
+                    }
+                _window.GetStyleContext().AddProvider(_transparencyCss, 800);
+                }
+            else {
+                if (_transparencyCss != null) {
+                    _window.GetStyleContext().RemoveProvider(_transparencyCss);
+                    }
+                Gdk.Surface? nativeSurface = CurrentNativeSurface();
+                nativeSurface?.SetInputRegion(null!);
+                }
+            Invalidate();
+            }
+
+        private void UpdateTransparencyInput(SKPixmap pixels, int scale) {
+            if (!_isShaped) {
+                return;
+                }
+            Gdk.Surface? nativeSurface = CurrentNativeSurface();
+            if (nativeSurface == null) {
+                return;
+                }
+            // GDK input regions use logical pixels. Include a logical pixel if ANY of its
+            // physical samples is visible, so fractional edges are clickable at HiDPI too.
+            ReadOnlySpan<byte> buffer = pixels.GetPixelSpan();
+            _nextInputRows.Clear();
+            if (_owner is Form form && form.PointerInputTransparent) {
+                ApplyNativeInputRegion(nativeSurface);
+                _inputRegionValid = false;
+                return;
+                }
+            int pixelWidth = pixels.Width;
+            int pixelHeight = pixels.Height;
+            int rowBytes = pixels.RowBytes;
+            int logicalWidth = (pixelWidth + scale - 1) / scale;
+            int logicalHeight = (pixelHeight + scale - 1) / scale;
+            for (int row = 0; row < logicalHeight; row++) {
+                int runStart = -1;
+                for (int column = 0; column <= logicalWidth; column++) {
+                    bool visible = column < logicalWidth && HasVisiblePixel(buffer, rowBytes, pixelWidth, pixelHeight, column, row, scale);
+                    if (visible && runStart < 0) {
+                        runStart = column;
+                        }
+                    else if (!visible && runStart >= 0) {
+                        _nextInputRows.Add(new Rectangle(runStart, row, column - runStart, 1));
+                        runStart = -1;
+                        }
+                    }
+                }
+            if (_inputRegionValid && _inputRows.Count == _nextInputRows.Count) {
+                bool unchanged = true;
+                for (int row = 0; row < _inputRows.Count; row++) {
+                    if (_inputRows[row] != _nextInputRows[row]) {
+                        unchanged = false;
+                        break;
+                        }
+                    }
+                if (unchanged) {
+                    return;
+                    }
+                }
+            ApplyNativeInputRegion(nativeSurface);
+            List<Rectangle> previousRows = _inputRows;
+            _inputRows = _nextInputRows;
+            _nextInputRows = previousRows;
+            _inputRegionValid = true;
+            }
+
+        private static bool HasVisiblePixel(ReadOnlySpan<byte> buffer, int rowBytes, int width, int height, int column, int row, int scale) {
+            int lastRow = Math.Min((row + 1) * scale, height);
+            int lastColumn = Math.Min((column + 1) * scale, width);
+            for (int sampleRow = row * scale; sampleRow < lastRow; sampleRow++) {
+                for (int sampleColumn = column * scale; sampleColumn < lastColumn; sampleColumn++) {
+                    if (buffer[sampleRow * rowBytes + sampleColumn * 4 + 3] != 0) {
+                        return true;
+                        }
+                    }
+                }
+            return false;
+            }
+
+        private void ApplyNativeInputRegion(Gdk.Surface nativeSurface) {
+            // gir.core exposes the region object but not Cairo's region-building functions.
+            // Keep that small native operation here; Cairo is already required by GTK4.
+            IntPtr nativeRegion = CairoRegionCreate();
+            try {
+                foreach (Rectangle row in _nextInputRows) {
+                    NativeRectangle rectangle = new NativeRectangle {
+                        X = row.X,
+                        Y = row.Y,
+                        Width = row.Width,
+                        Height = row.Height
+                        };
+                    int status = CairoRegionUnionRectangle(nativeRegion, ref rectangle);
+                    if (status != 0) {
+                        throw new InvalidOperationException("Cairo input region failed: " + status);
+                        }
+                    }
+                using Cairo.Region region = new Cairo.Region(Cairo.Internal.RegionOwnedHandle.FromUnowned(nativeRegion));
+                nativeSurface.SetInputRegion(region);
+                // Do not let the compositor treat transparent corners as opaque damage regions.
+                IntPtr nativeEmptyRegion = CairoRegionCreate();
+                try {
+                    using Cairo.Region emptyRegion = new Cairo.Region(Cairo.Internal.RegionOwnedHandle.FromUnowned(nativeEmptyRegion));
+                    nativeSurface.SetOpaqueRegion(emptyRegion);
+                    }
+                finally {
+                    CairoRegionDestroy(nativeEmptyRegion);
+                    }
+                }
+            finally {
+                CairoRegionDestroy(nativeRegion);
+                }
+            }
+
+        [StructLayout(LayoutKind.Sequential)]
+        private struct NativeRectangle {
+            public int X;
+            public int Y;
+            public int Width;
+            public int Height;
+            }
+
+        [DllImport("libcairo.so.2", EntryPoint = "cairo_region_create")]
+        private static extern IntPtr CairoRegionCreate();
+
+        [DllImport("libcairo.so.2", EntryPoint = "cairo_region_union_rectangle")]
+        private static extern int CairoRegionUnionRectangle(IntPtr region, ref NativeRectangle rectangle);
+
+        [DllImport("libcairo.so.2", EntryPoint = "cairo_region_destroy")]
+        private static extern void CairoRegionDestroy(IntPtr region);
+        }
+    }
