+using System;
+using System.Drawing;
+
+namespace Majorsilence.Forms.Gtk4 {
+    internal sealed partial class Gtk4WindowHost {
+        private global::Gtk.Popover? _relativePopup;
+        private Gtk4WindowHost? _popupParent;
+        private global::Gtk.CssProvider? _popupCss;
+        private bool _closingPopup;
+
+        // Wayland forbids positioning independent top-levels. Menus and non-activating
+        // owned previews instead use native parent-relative popup surfaces.
+        private bool ShowRelativePopup() {
+            WindowBase? parent = _owner is PopupWindow popup ? popup.ParentWindow
+                : !ShowActivated && _owner is Form form ? form.Owner : null;
+            if (parent?.Backend is not Gtk4WindowHost host) {
+                return false;
+                }
+            if (_relativePopup is null) {
+                _popupParent = host;
+                _relativePopup = global::Gtk.Popover.New();
+                _relativePopup.SetHasArrow(false);
+                _relativePopup.SetAutohide(_isPopup && ShowActivated);
+                _relativePopup.SetCanFocus(ShowActivated);
+                _relativePopup.SetFocusable(ShowActivated);
+                _relativePopup.SetParent(host._surface.Widget);
+                _window.SetChild(null!);
+                _relativePopup.SetChild(_overlay);
+                _popupCss = global::Gtk.CssProvider.New();
+                _relativePopup.AddCssClass("mnx-relative-popup");
+                _popupCss.LoadFromString("popover.mnx-relative-popup, popover.mnx-relative-popup > contents { background: transparent; border: none; border-radius: 0; box-shadow: none; padding: 0; margin: 0; }");
+                global::Gtk.StyleContext.AddProviderForDisplay(_window.GetDisplay(), _popupCss, 800);
+                _relativePopup.OnClosed += (_, _) => {
+                    if (!_closingPopup && _owner.Visible) {
+                        _owner.OnBackendDeactivated();
+                        _owner.Hide();
+                        }
+                    };
+                }
+            _overlay.SetSizeRequest(Math.Max(1, _size.Width), Math.Max(1, _size.Height));
+            UpdateRelativePopupPosition();
+            _relativePopup.Popup();
+            _inputRegionValid = false;
+            if (ShowActivated) {
+                _owner.OnBackendActivated();
+                }
+            return true;
+            }
+
+        private void UpdateRelativePopupPosition() {
+            if (_relativePopup is null || _popupParent is null) {
+                return;
+                }
+            Point origin = _popupParent.PointToClient(_location);
+            using Gdk.Rectangle anchor = new Gdk.Rectangle { X = origin.X, Y = origin.Y, Width = 1, Height = 1 };
+            _relativePopup.SetPosition(global::Gtk.PositionType.Bottom);
+            _relativePopup.SetPointingTo(anchor);
+            // A bottom popup is horizontally centered on its anchor; offset to
+            // preserve the top-left positioning contract used by WinForms.
+            _relativePopup.SetOffset(_size.Width / 2, -1);
+            }
+
+        private void HideRelativePopup() {
+            if (_relativePopup is null) {
+                return;
+                }
+            _closingPopup = true;
+            try {
+                _relativePopup.Popdown();
+                }
+            finally {
+                _closingPopup = false;
+                }
+            }
+
+        private void DisposeRelativePopup() {
+            if (_relativePopup is not null) {
+                HideRelativePopup();
+                _relativePopup.SetChild(null!);
+                _relativePopup.Unparent();
+                _relativePopup.Dispose();
+                _relativePopup = null;
+                }
+            if (_popupCss is not null) {
+                global::Gtk.StyleContext.RemoveProviderForDisplay(_window.GetDisplay(), _popupCss);
+                _popupCss.Dispose();
+                }
+            _popupCss = null;
+            }
+
+        private Gdk.Surface? CurrentNativeSurface() {
+            return _relativePopup?.GetSurface() ?? _window.GetNative()?.GetSurface();
+            }
+        }
+    }
