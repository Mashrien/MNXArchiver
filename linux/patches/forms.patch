+        public async Task<string?> ShowSaveFileDialog(SaveFileRequest request) {
+            string[] files = await ChooseFiles(request.Title ?? "Save file", global::Gtk.FileChooserAction.Save,
+                request.InitialDirectory, request.SuggestedFileName, false, request.Filters, request.FilterIndex);
+            return files.Length == 0 ? null : files[0];
+            }
+
+        public async Task<string?> ShowOpenFolderDialog(FolderDialogRequest request) {
+            string[] folders = await ChooseFiles(request.Title ?? "Choose folder", global::Gtk.FileChooserAction.SelectFolder,
+                request.InitialDirectory, null, false, Array.Empty<FileDialogFilter>(), 1);
