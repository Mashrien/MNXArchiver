+using System;
+using System.Collections.Generic;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Threading.Tasks;
+using Majorsilence.Forms.Backends;
+
+namespace Majorsilence.Forms.Gtk4 {
+    internal sealed partial class Gtk4WindowHost : INativeFileDragBackend {
+        private global::Gtk.DropTarget? _fileDropTarget;
+
+        [DllImport("libgtk-4.so.1", CallingConvention = CallingConvention.Cdecl)]
+        private static extern IntPtr gdk_file_list_get_files(IntPtr fileList);
+
+        private void InitializeFileDrag() {
+            _fileDropTarget = global::Gtk.DropTarget.New(Gdk.FileList.GetGType(), Gdk.DragAction.Copy);
+            _fileDropTarget.SetPreload(true);
+            _fileDropTarget.OnEnter += (_, args) => FileDragOver(args.X, args.Y);
+            _fileDropTarget.OnMotion += (_, args) => FileDragOver(args.X, args.Y);
+            _fileDropTarget.OnLeave += (_, _) => _owner.HandleExternalDragLeave();
+            _fileDropTarget.OnDrop += (_, args) => {
+                DataObject? files = ReadFileDrop(args.Value);
+                if (files is null) {
+                    return false;
+                    }
+                return _owner.HandleExternalDrop(files, DragDropEffects.Copy,
+                    FileDragCoordinate(args.X), FileDragCoordinate(args.Y), Keys.None) != DragDropEffects.None;
+                };
+            _surface.Widget.AddController(_fileDropTarget);
+            }
+
+        private int FileDragCoordinate(double value) {
+            return (int)Math.Round(value * _surface.Scaling);
+            }
+
+        private Gdk.DragAction FileDragOver(double x, double y) {
+            DataObject? files = ReadFileDrop(_fileDropTarget!.GetValue());
+            if (files is null) {
+                return (Gdk.DragAction)0;
+                }
+            DragDropEffects effect = _owner.HandleExternalDragOver(files, DragDropEffects.Copy,
+                FileDragCoordinate(x), FileDragCoordinate(y), Keys.None);
+            return effect == DragDropEffects.None ? (Gdk.DragAction)0 : Gdk.DragAction.Copy;
+            }
+
+        private static DataObject? ReadFileDrop(GObject.Value? value) {
+            if (value is null) {
+                return null;
+                }
+            IntPtr boxed = value.GetBoxed();
+            if (boxed == IntPtr.Zero) {
+                return null;
+                }
+            List<string> paths = new List<string>();
+            // The GSList and its files belong to GdkFileList and remain borrowed here.
+            for (IntPtr item = gdk_file_list_get_files(boxed); item != IntPtr.Zero; item = Marshal.ReadIntPtr(item, IntPtr.Size)) {
+                using Gio.FileHelper file = Gio.FileHelper.NewFromPointer(Marshal.ReadIntPtr(item), false);
+                string? path = file.GetPath();
+                if (!string.IsNullOrEmpty(path)) {
+                    paths.Add(path);
+                    }
+                }
+            return paths.Count == 0 ? null : new DataObject(DataFormats.FileDrop, paths.ToArray());
+            }
+
+        public Task<DragDropEffects> BeginFileDrag(string[] paths, DragDropEffects allowedEffects) {
+            if ((allowedEffects & DragDropEffects.Copy) == 0 || paths.Length == 0) {
+                return Task.FromResult(DragDropEffects.None);
+                }
+            Gdk.Surface? surface = _window.GetNative()?.GetSurface();
+            Gdk.Device? pointer = Gdk.Display.GetDefault()?.GetDefaultSeat()?.GetPointer();
+            if (surface is null || pointer is null) {
+                return Task.FromResult(DragDropEffects.None);
+                }
+            StringBuilder uris = new StringBuilder();
+            foreach (string path in paths) {
+                uris.Append(new Uri(System.IO.Path.GetFullPath(path)).AbsoluteUri).Append("\r\n");
+                }
+            using GLib.Bytes bytes = GLib.Bytes.New(Encoding.UTF8.GetBytes(uris.ToString()));
+            Gdk.ContentProvider provider = Gdk.ContentProvider.NewForBytes("text/uri-list", bytes);
+            Gdk.Drag? drag = Gdk.Drag.Begin(surface, pointer, provider, Gdk.DragAction.Copy, 0, 0);
+            if (drag is null) {
+                provider.Dispose();
+                return Task.FromResult(DragDropEffects.None);
+                }
+            TaskCompletionSource<DragDropEffects> completion = new TaskCompletionSource<DragDropEffects>();
+            void Finish(bool success) {
+                if (completion.Task.IsCompleted) {
+                    return;
+                    }
+                drag.DropDone(success);
+                completion.SetResult(success ? DragDropEffects.Copy : DragDropEffects.None);
+                drag.Dispose();
+                provider.Dispose();
+                }
+            drag.OnCancel += (_, _) => Finish(false);
+            drag.OnDndFinished += (_, _) => Finish(drag.GetSelectedAction() == Gdk.DragAction.Copy);
+            return completion.Task;
+            }
+        }
+    }
