+using System;
+using System.Runtime.InteropServices;
+
+namespace Majorsilence.Forms.Gtk4 {
+    internal sealed partial class Gtk4WindowHost {
+        private bool IsRightPreviewOnX11() {
+            if (_owner is not Form form || form.Tag as string != "MNX.Preview.RightWindow") {
+                return false;
+                }
+            IntPtr display = _window.GetDisplay().Handle.DangerousGetHandle();
+            return Marshal.PtrToStringUTF8(NativeTypeName(display)) == "GdkX11Display";
+            }
+
+        private void PositionRightPreviewOnX11() {
+            if (_owner is not Form form || form.Owner?.Backend is not Gtk4WindowHost parent) {
+                return;
+                }
+            Gdk.Surface? surface = _window.GetSurface();
+            Gdk.Surface? parentSurface = parent._window.GetSurface();
+            if (surface is null || parentSurface is null) {
+                return;
+                }
+            IntPtr display = XDisplay(_window.GetDisplay().Handle.DangerousGetHandle());
+            nuint parentId = XSurface(parentSurface.Handle.DangerousGetHandle());
+            nuint previewId = XSurface(surface.Handle.DangerousGetHandle());
+            if (XTranslateCoordinates(display, parentId, XDefaultRootWindow(display), 0, 0, out int x, out int y, out _) == 0) {
+                return;
+                }
+            // X11 coordinates are physical pixels; GTK sizes are logical pixels.
+            int scale = parentSurface.GetScaleFactor();
+            XMoveWindow(display, previewId, x + parentSurface.GetWidth() * scale, y);
+            XSync(display, 0);
+            }
+
+        [DllImport("libgobject-2.0.so.0", EntryPoint = "g_type_name_from_instance")]
+        private static extern IntPtr NativeTypeName(IntPtr instance);
+        [DllImport("libgtk-4.so.1", EntryPoint = "gdk_x11_display_get_xdisplay")]
+        private static extern IntPtr XDisplay(IntPtr display);
+        [DllImport("libgtk-4.so.1", EntryPoint = "gdk_x11_surface_get_xid")]
+        private static extern nuint XSurface(IntPtr surface);
+        [DllImport("libX11.so.6")]
+        private static extern nuint XDefaultRootWindow(IntPtr display);
+        [DllImport("libX11.so.6")]
+        private static extern int XTranslateCoordinates(IntPtr display, nuint source, nuint destination, int sourceX, int sourceY, out int destinationX, out int destinationY, out nuint child);
+        [DllImport("libX11.so.6")]
+        private static extern int XMoveWindow(IntPtr display, nuint window, int x, int y);
+        [DllImport("libX11.so.6")]
+        private static extern int XSync(IntPtr display, int discard);
+        }
+    }
