@@ -0,0 +1,113 @@
+using System.Drawing;
+
+namespace Majorsilence.Forms;
+
+public partial class ListView {
+    private readonly HorizontalScrollBar hscrollbar = new HorizontalScrollBar {
+        Minimum = 0,
+        Maximum = 0,
+        SmallChange = 24,
+        LargeChange = 1,
+        Visible = false,
+        Dock = DockStyle.None
+        };
+    private bool updatingScrollBars;
+
+    // Rendering and hit tests use device coordinates. The scrollbar uses the same
+    // units so its last position aligns the final cell exactly with the viewport.
+    internal int HorizontalContentOffset {
+        get {
+            if (View != View.Details || !hscrollbar.Visible) {
+                return 0;
+                }
+            return MirrorsColumns ? hscrollbar.Value : -hscrollbar.Value;
+            }
+        }
+
+    private void InitializeHorizontalScrolling() {
+        hscrollbar.ValueChanged += (_, _) => Invalidate();
+        Controls.AddImplicitControl(hscrollbar);
+        }
+
+    /// <inheritdoc/>
+    protected override void OnSizeChanged(EventArgs e) {
+        base.OnSizeChanged(e);
+        UpdateVerticalScrollBar();
+        }
+
+    internal void UpdateVerticalScrollBar() {
+        // Base constructors can deliver SizeChanged before the bars are created.
+        if (updatingScrollBars || vscrollbar is null || hscrollbar is null) {
+            return;
+            }
+        updatingScrollBars = true;
+        try {
+            if (View == View.Details) {
+                UpdateDetailsScrollBars();
+                }
+            else {
+                hscrollbar.Visible = false;
+                hscrollbar.Value = 0;
+                UpdateVerticalScrollBarCore();
+                }
+            PositionScrollBars();
+            }
+        finally {
+            updatingScrollBars = false;
+            }
+        }
+
+    private void UpdateDetailsScrollBars() {
+        Rectangle client = PaddedClientRectangle;
+        long columnsWidth = ScaledCheckWidth;
+        foreach (ColumnHeader column in DisplayColumns) {
+            columnsWidth += ScaledColumnWidth(column);
+            }
+        int contentWidth = (int)Math.Min(int.MaxValue, columnsWidth);
+        int lines = LineCount;
+        bool horizontal = false;
+        bool vertical = false;
+        int width = client.Width;
+        int visibleLines = 1;
+
+        // Either bar can make the other necessary. Resolve their joint viewport
+        // without toggling live visibility during each paint (which would repaint forever).
+        for (int pass = 0; pass < 3; pass++) {
+            width = Math.Max(0, client.Width - (vertical ? vscrollbar.ScaledWidth : 0));
+            int height = Math.Max(0, client.Height - ScaledHeaderHeight -
+                (horizontal ? hscrollbar.ScaledHeight : 0));
+            horizontal = Scrollable && contentWidth > width;
+            visibleLines = Math.Max(1, height / Math.Max(1, ScaledLineHeight));
+            vertical = Scrollable && lines > visibleLines;
+            }
+        hscrollbar.Visible = horizontal;
+        vscrollbar.Visible = vertical;
+        hscrollbar.Maximum = Math.Max(0, contentWidth - 1);
+        hscrollbar.LargeChange = Math.Max(1, width);
+        hscrollbar.SmallChange = Math.Max(1, LogicalToDeviceUnits(24));
+        int maximumLeft = horizontal ? Math.Max(0, contentWidth - width) : 0;
+        hscrollbar.Value = Math.Clamp(hscrollbar.Value, 0, maximumLeft);
+
+        vscrollbar.Maximum = Math.Max(0, lines - 1);
+        vscrollbar.LargeChange = visibleLines;
+        int maximumTop = vertical ? Math.Max(0, lines - visibleLines) : 0;
+        top_index = Math.Clamp(top_index, 0, maximumTop);
+        vscrollbar.Value = top_index;
+        }
+
+    private void PositionScrollBars() {
+        Rectangle client = PaddedClientRectangle;
+        int verticalWidth = vscrollbar.Visible ? Math.Min(client.Width, vscrollbar.ScaledWidth) : 0;
+        int horizontalHeight = hscrollbar.Visible ? Math.Min(client.Height, hscrollbar.ScaledHeight) : 0;
+        Rectangle vertical = new Rectangle(client.Right - verticalWidth, client.Top,
+            verticalWidth, Math.Max(0, client.Height - horizontalHeight));
+        Rectangle horizontal = new Rectangle(client.Left, client.Bottom - horizontalHeight,
+            Math.Max(0, client.Width - verticalWidth), horizontalHeight);
+        if (vscrollbar.Visible) {
+            vscrollbar.Bounds = DeviceToLogicalUnits(vertical);
+            }
+        if (hscrollbar.Visible) {
+            hscrollbar.Bounds = DeviceToLogicalUnits(horizontal);
+            }
+        }
+    }
