<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>mnx-gui</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishAot Condition="'$(MNXNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Portable user installs keep the engine and drawing libraries beside the executable. -->
    <LinkerArg Include="-Wl,-rpath,'$ORIGIN'" />
    <Compile Include="Launcher/*.cs" />
    <ProjectReference Include="Backends/MNXFile.Backends.csproj" />
    <ProjectReference Include="MNXFile.MWinFrontend.csproj" />
    <ProjectReference Include="../src/MNXFile.Gtk3Frontend.csproj" />
    <TrimmerRootAssembly Include="MNXFile.MWin.Frontend" />
    <TrimmerRootAssembly Include="MNXFile.Gtk3.Frontend" />
    <TrimmerRootAssembly Include="MWindow" />
    <TrimmerRootAssembly Include="Majorsilence.Forms" />
    <TrimmerRootAssembly Include="Majorsilence.Forms.Drawing.Common" />
    <TrimmerRootAssembly Include="GtkSharp" />
    <TrimmerRootAssembly Include="GdkSharp" />
    <TrimmerRootAssembly Include="GLibSharp" />
    <TrimmerRootAssembly Include="GioSharp" />
    <TrimmerRootAssembly Include="AtkSharp" />
    <TrimmerRootAssembly Include="PangoSharp" />
    <TrimmerRootAssembly Include="CairoSharp" />
  </ItemGroup>
</Project>
